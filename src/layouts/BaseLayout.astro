---
import "../styles/global.css";
const { title = "CV App" } = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth dark">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <meta name="color-scheme" content="dark light" />
        <title>{title}</title>
    </head>
    <body class="min-h-dvh bg-zinc-50 text-zinc-900 antialiased transition-colors duration-300 selection:bg-cyan-400/30 selection:text-zinc-50 dark:bg-zinc-950 dark:text-zinc-100">

        <div aria-hidden="true" class="pointer-events-none fixed inset-0 -z-10 overflow-hidden">
            <!-- Glow 1 -->
            <div class="absolute -top-24 left-1/2 h-130 w-130 -translate-x-1/2 rounded-full blur-3xl bg-linear-to-tr from-violet-500/12 via-cyan-400/10 to-emerald-400/10 dark:from-violet-500/20 dark:via-cyan-400/10 dark:to-emeral-400/10"></div>
            
            <!-- Glow 2 -->
            <div class="absolute top-40 -left-24 h-105 w-105 rounded-full blur-3xl bg-linear-to-tr from-emerald-400/10 via-cyan-400/8 to-violet-500/8 dark:from-emerald-400/10 dark:via-cyan-400/10 dark:to-violet-500/10"></div>

            <!-- Glow 3 -->
            <div class="absolute -bottom-28 right-0 h-130 w-130 rounded-full blur-3xl bg-linear-to-tr from-cyan-400/8 via-violet-500/8 to-emerald-400/8 dark:from-cyan-400/10 dark:via-violet-500/10 dark:to-emerald-400/10"></div>
            
            <!-- top radial wash -->
            <!-- <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(0,0,0,0.04),rgba(255,255,255,0))] dark:bg-[radial-gradient(ellipse_at_top,rgba(255,255,255,0.06),rgba(0,0,0,0))]"></div> -->

            <!-- grid -->
            <!-- <div class="absolute inset-0 opacity-20 dark:opacity-30 [background-image:linear-gradient(to_right,rgba(0,0,0,0.05)_1px,transparent_1px),linear-gradient(to_bottom,rgba(0,0,0,0.05)_1px,transparent_1px)] dark:[background-image:linear-gradient(to_right,rgba(255,255,255,0.06)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.06)_1px,transparent_1px)] [background-size:64px_64px]"></div> -->

        </div>

        <slot />

        <script src="/src/scripts/theme-toggle.js"></script>
        <script src="/src/scripts/ui.js"></script>
        <script src="/src/scripts/skills-tabs.js"></script>

    </body>

</html>