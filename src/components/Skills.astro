
---
import skillsData from '../data/skills.json';
---

<section id="skill"
  class="scroll-mt-24 border-t border-black/10 py-14 dark:border-white/10 sm:py-18"
  aria-label="Habilidades tècnicas"
  data-skills-root>

  <div class="mx-auto">  
    <h2 class="text-2xl font-semibold tracking-tight text-zinc-900 dark:text-zinc-50">    
      {skillsData.title}
    </h2>

    <p class="mt-4 max-w-3xl text-balance text-base leading-8 text-zinc-600 dark:text-zinc-400 sm:text-lg">
      {skillsData.description}
    </p>

    <div
      class="relative mt-12 flex flex-wrap items-center justify-center gap-3"
      role="tablist"
      aria-label="Categorías del stack tecnológico"
      data-skills-tabs>
      <span
        data-skills-pill
        class="pointer-events-none absolute left-0 top-0 hidden rounded-2xl bg-linear-to-r from-violet-500 via-cyan-400 to-emerald-400 shadow-[0_16px_50px_rgba(34,211,238,0.16)] transition-all duration-300 ease-out md:block"
        aria-hidden="true"
      ></span>

      {skillsData.categories.map((category, index) => (
        <button
          type="button"
          role="tab"
          aria-selected={index === 0 ? "true" : "false"}
          tabindex={index === 0 ? "0" : "-1"}
          data-skill-tab={category.id}
          class:list={[
            "skills-tab relative z-10 inline-flex items-center gap-2 rounded-2xl px-5 py-3 text-sm font-semibold transition-all duration-300 cursor-pointer",
            index === 0 
            ? "is-active text-white" 
            : "text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100"
          ]}
          >
          <span class="relative z-10 inline-flex items-center gap-2">
            {category.icon === "codeLanguages" && (
              <svg aria-hidden="true" class="h-5 w-5 fill-none stroke-current" stroke-width="2">
                <use xlink:href="../public/assets/sprite.svg#codeLanguages"></use>
              </svg>
            )}
            {category.icon === "globe" && (
              <svg aria-hidden="true" class="h-5 w-5 fill-none stroke-current" stroke-width="2">
                <use xlink:href="../public/assets/sprite.svg#globe"></use>
              </svg>
            )}

            {category.icon === "database" && (
              <svg aria-hidden="true" class="h-5 w-5 fill-none stroke-current" stroke-width="2">
                <use xlink:href="../public/assets/sprite.svg#database"></use>
              </svg>
            )}

            {category.icon === "boxes" && (
              <svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5 fill-none stroke-current" stroke-width="2">
                <use xlink:href="../public/assets/sprite.svg#boxes"></use>
              </svg>
            )}
            <span>{category.title}</span>
          </span>
        </button>
      ))}
    </div>

    <div class="relative mt-12" data-skills-panels>
      {skillsData.categories.map((category, index) => (
        <div
          id="tabpanel"
          aria-hidden= { index === 0 ? "false" : "true" }
          data-skill-panel={category.id}
          class:list={[
            "skills-panel transition-all duration-500 ease-out",          
            index === 0 ? "opacity-100 translate-y-0 pointer-events-auto" : "hidden opacity-0 translate-y-4 pointer-events-none"
          ]}
          >

          <div
            class:list={[
              "pointer-events-none absolute -inset-4 rounded-4xl bg-linear-to-r opacity-[0.06] blur-3xl",
              category.gradient
            ]}
            aria-hidden="true">
          </div>

          <div class="relative grid grid-cols-1 gap-4 md:grid-cols-2"> 

            {category.skills.map((skill, skillIndex) => (
              <article
                class="skills-card group relative rounded-[1.75rem] bg-white/70 p-6 ring-1 ring-black/10 backdrop-blur-xl transition duration-300 hover:-translate-y-1 hover:bg-white/85 hover:shadow-[0_22px_80px_rgba(34,211,238,0.10)] dark:bg-white/5 dark:ring-white/10 dark:hover:bg-white/7"
                style={`--skill-delay:${skillIndex * 60}ms;`}
                >

                <div
                  class:list={[
                    "pointer-events-none absolute inset-0 rounded-[1.75rem] bg-linear-to-r opacity-0 transition-opacity duration-300 group-hover:opacity-[0.06]",
                    category.gradient
                  ]}
                  aria-hidden="true"
                ></div>

                <div class="relative flex items-start gap-4">
                  <div
                    class:list={[
                      "inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-linear-to-br text-white shadow-[0_10px_30px_rgba(0,0,0,0.18)]",
                      category.gradient
                    ]}
                  >
                    <svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5 fill-none stroke-current" stroke-width="2">
                      <circle cx="12" cy="12" r="9" />
                      <path d="m9 12 2 2 4-4" />
                    </svg>
                  </div>

                  <div class="min-w-0 flex-1">
                    <h3 class="text-lg font-bold text-zinc-900 dark:text-zinc-100">
                      {skill.name}
                    </h3>
                    <p class="mt-1 text-sm leading-7 text-zinc-600 dark:text-zinc-400">
                      {skill.description}
                    </p>
                  </div>
                </div>

                <div class="relative mt-5 flex flex-wrap gap-2">
                  {skill.tags.map((tag) => (
                    <span class="rounded-xl bg-white/80 px-3 py-1 text-xs font-medium text-zinc-700 ring-1 ring-black/10 dark:bg-white/5 dark:text-zinc-300 dark:ring-white/10">
                      {tag}
                    </span>
                  ))}
                </div>


              </article>



            ))}

          </div>
        </div>
      ))}
    </div>
  </div>
</section>


