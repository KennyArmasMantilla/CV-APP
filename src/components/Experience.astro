---
import experienceData from '../data/experience.json';
---
<section
  id="experience"
  class="scroll-mt-24 border-t border-black/10 py-14 dark:border-white/10 sm:py-18"
  aria-label="Experiencia"
>
  <div class="flex flex-col gap-4">
    <div>
      <h2 class="text-2xl font-semibold tracking-tight text-zinc-900 dark:text-zinc-50">
        Experiencia 
      </h2>
      <p class="mt-2 text-pretty text-zinc-500 dark:text-zinc-400">
        Timeline interactivo con cards visuales, scroll sincronizado y detalle por experiencia.
      </p>
    </div>

    <div class="experience-layout grid gap-6 lg:grid-cols-[220px_minmax(0,1fr)] lg:items-start">
      <!-- Timeline -->
       <aside class="lg:sticky lg:top-24">
        <div class="experience-timeline p-0">
          <ol class="relative" role="list" aria-label="Timeline de años">
            {experienceData.map((group, index) => (
              <li class="timeline-year-item">
                <button
                  type="button"
                  class:list={[
                    "timeline-year-btn",
                    index === 0 && "is-active"
                  ]}
                  data-target={`year-${group.year}`}
                  aria-label={`Ir al año ${group.year}`}
                  >
                  <span class="timeline-label">{group.year}</span>
                  <span class="timeline-dot"></span>
                </button>
              </li>
            ))}
          </ol>
        </div>
       </aside>

      <!-- Scroll area -->
      <div class="overflow-hidden">
        <div
          id="experienceScroller"
          class="experience-scroll max-h-190 overflow-y-auto p-5 sm:p-6"
          role="region"
          aria-label="Detalles de experiencia por año"
          tabindex="0">

          <div class="space-y-10">
            {experienceData.map((group) => (
              <section
                id={`year-${group.year}`}
                class="experience-year-section space-y-5"
                data-year={group.year}
              >
                <div class="flex items-center gap-3">
                  <span class="card-badge">{group.year}</span>
                  <div class="h-px flex-1 bg-cyan-400/40 dark:bg-cyan-300/30"></div>
                </div>

                <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-2">
                  {group.items.map((item) => (
                    <article
                      id={item.id}
                      class="experience-card group rounded-3xl bg-white/72 p-5 ring-1 ring-black/10 backdrop-blur-xl transition duration-300 hover:-translate-y-1 hover:bg-white/90 hover:shadow-[0_22px_80px_rgba(34,211,238,0.12)] dark:bg-white/5 dark:ring-white/10 dark:hover:bg-white/7"
                      data-year={group.year}
                    >
                      <div class="relative overflow-hidden rounded-2xl ring-1 ring-black/10 dark:ring-white/10">
                        <img
                          src={item.image}
                          alt={item.title}
                          class="aspect-16/10 w-full object-cover"
                          loading="lazy"
                        />
                        <div class="absolute left-4 top-4">
                          <span class="card-badge">{item.badge}</span>
                        </div>
                      </div>

                      <div class="mt-4">
                        <h3 class="text-lg font-semibold text-zinc-900 dark:text-zinc-100">
                          {item.title}
                        </h3>
                        <p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">
                          {item.company} · {item.date}
                        </p>
                      </div>

                      <p class="mt-3 text-sm leading-7 text-zinc-700 dark:text-zinc-300">
                        {item.summary}
                      </p>

                      <div class="mt-4 flex flex-wrap gap-2">
                        {item.tech.slice(0, 4).map((tech) => (
                          <span class="quick-pill">{tech}</span>
                        ))}
                      </div>

                      <div class="mt-6 flex justify-center">
                        <button
                          type="button"
                          class="experience-detail-btn inline-flex items-center gap-2 rounded-xl bg-linear-to-tr from-violet-500/85 via-cyan-400/85 to-emerald-400/85 px-5 py-3 text-sm font-semibold text-zinc-950 shadow-[0_16px_60px_rgba(34,211,238,0.16)] transition duration-300 hover:-translate-y-0.5 hover:shadow-[0_20px_80px_rgba(34,211,238,0.24)] focus:outline-none focus-visible:ring-2 focus-visible:ring-cyan-400"
                          data-modal-id={item.id}
                          data-modal-title={item.title}
                          data-modal-date={item.date}
                          data-modal-company={item.company}
                          data-modal-client={item.client}
                          data-modal-description={item.description}
                          data-modal-tech={item.tech.join(", ")}
                          data-modal-image={item.image}
                          data-modal-location={item.location}
                          data-modal-badge={item.badge}
                        >
                          Detalle
                        </button>
                      </div>
                    </article>
                  ))}
                </div>
              </section>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>

</section>