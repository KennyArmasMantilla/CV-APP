<div
  id="experienceModalOverlay"
  class="pointer-events-none fixed inset-0 z-[140] hidden opacity-0 transition duration-300"
  aria-hidden="true"
></div>

<button
  id="experienceModalClose"
  type="button"
  class="pointer-events-none fixed right-6 top-6 z-[170] hidden h-16 w-16 items-center justify-center rounded-full bg-white/12 text-white ring-1 ring-white/15 backdrop-blur-xl transition duration-300 hover:scale-105 hover:bg-white/18 dark:bg-white/10 dark:text-white dark:ring-white/15"
  aria-label="Cerrar modal"
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    class="h-7 w-7 fill-none stroke-current"
    stroke-width="2.2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M18 6 6 18" />
    <path d="m6 6 12 12" />
  </svg>
</button>

<div
  id="experienceModal"
  class="pointer-events-none fixed left-1/2 top-1/2 z-[160] hidden w-[min(820px,calc(100%-2rem))] -translate-x-1/2 -translate-y-1/2 rounded-[30px] bg-white/92 p-6 opacity-0 ring-1 ring-black/10 shadow-[0_40px_140px_rgba(0,0,0,0.22)] backdrop-blur-2xl transition duration-300 dark:bg-zinc-950/88 dark:ring-white/10 dark:shadow-[0_40px_140px_rgba(0,0,0,0.50)]"
  role="dialog"
  aria-modal="true"
  aria-labelledby="experienceModalTitle"
>
  <div class="space-y-5">
    <div class="relative overflow-hidden rounded-2xl ring-1 ring-black/10 dark:ring-white/10">
      <img
        id="experienceModalImage"
        src=""
        alt=""
        class="aspect-[16/9] w-full object-cover"
      />
    </div>

    <div class="flex flex-wrap items-start justify-between gap-3">
      <div>
        <p id="experienceModalDate" class="text-sm text-zinc-500 dark:text-zinc-400"></p>
        <h3 id="experienceModalTitle" class="mt-1 text-2xl font-semibold text-zinc-900 dark:text-zinc-100"></h3>
      </div>

      <span
        id="experienceModalLocation"
        class="rounded-full bg-white/60 px-3 py-1 font-mono text-[11px] text-zinc-700 ring-1 ring-black/10 dark:bg-zinc-950/40 dark:text-zinc-300 dark:ring-white/10"
      ></span>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      <div class="card-block">
        <p class="text-xs text-zinc-500 dark:text-zinc-400">Empresa</p>
        <p id="experienceModalCompanyText" class="mt-1 text-sm font-semibold text-zinc-900 dark:text-zinc-100"></p>
      </div>

      <div class="card-block">
        <p class="text-xs text-zinc-500 dark:text-zinc-400">Cliente / contexto</p>
        <p id="experienceModalClient" class="mt-1 text-sm font-semibold text-zinc-900 dark:text-zinc-100"></p>
      </div>
    </div>

    <div class="card-block">
      <p class="text-xs text-zinc-500 dark:text-zinc-400">Qué se realizó</p>
      <p id="experienceModalDescription" class="mt-2 text-sm leading-7 text-zinc-700 dark:text-zinc-300"></p>
    </div>

    <div class="card-block">
      <p class="text-xs text-zinc-500 dark:text-zinc-400">Tecnologías</p>
      <div id="experienceModalTech" class="mt-3 flex flex-wrap gap-2"></div>
    </div>
  </div>
</div>