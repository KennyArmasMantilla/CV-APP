<header id="top" class="fixed inset-x-0 top-0 z-50 border-b border-black/8 bg-white/72 backdrop-blur-2xl dark:border-white/10 dark:bg-zinc-950/68">
    <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6">

        <!-- Logo y nombre -->
        <div class="flex items-center gap-3">
          <a href="#hero" class="group inline-flex items-center gap-3 rounded-xl px-2 py-1 focus:outline-none focus-visible:ring-2 focus-visible:ring-cyan-400" aria-label="Ir al inicio">
            <span
                class="relative inline-flex h-10 w-10 items-center justify-center overflow-hidden rounded-2xl bg-white/90 ring-1 ring-black/10 transition group-hover:bg-white dark:bg-white/5 dark:ring-white/10 dark:group-hover:bg-white/10"
                aria-hidden="true"
              >
              <span
                  class="absolute inset-0 bg-linear-to-tr from-violet-500/20 via-cyan-400/10 to-emerald-400/10"
                ></span>
              <img src="/logo.png" alt="kam" class="relative h-9 w-9 object-contain drop-shadow-[0_0_18px_rgba(34,211,238,0.35)]" loading="eager">

            </span>
                
            <div class="leading-tight">
              <p class="text-sm font-semibold tracking-tight text-zinc-900 dark:text-zinc-100">Kenny Armas Mantilla</p>
              <p class="text-xs text-muted">Senior Web Developer</p>
              </div>
          </a>
        </div>

        <!-- Navegacion desktop -->
        <nav class="hidden items-center gap-2 md:flex" aria-label="Navegación principal">
          <a href="#about-me" class="nav-link">Sobre mí</a>
          <a href="#skills" class="nav-link">Habilidades</a>
          <!-- <a href="#projects" class="nav-link">Proyectos</a> -->
          <a href="#experience" class="nav-link">Experiencia</a>
          <a href="#certifications" class="nav-link">Certificaciones</a>
        </nav>

        <!-- Right buttons -->
        <div class="flex items-center gap-3">
          <!-- Theme Toggle -->
                  
          <div
              id="themeToggle"
              class="relative hidden h-12 w-42.5 items-center rounded-full border border-black/8 bg-white/70 p-1 shadow-[0_8px_30px_rgba(0,0,0,0.10)] backdrop-blur-xl dark:border-white/10 dark:bg-zinc-950/60 dark:shadow-[0_8px_30px_rgba(0,0,0,0.25)] md:flex"
              role="button"
              tabindex="0"
              aria-label="Theme"
              aria-pressed="true">
              <!-- Sliding background -->
              <div 
                id="themeThumb"
                class="absolute left-1 top-1 h-10 w-[78px] rounded-full bg-slate-700/90 transition-all duration-300 ease-out">
              </div>

              <!-- Dark button -->
              <button
                id="darkBtn"
                type="button"
                class="theme-option relative z-10 flex h-10  w-[78px] cursor-pointer items-center justify-center gap-2 rounded-full text-sm font-semibold text-white transition-colors duration-300"
                data-theme="dark">
                <svg width="28" height="28" class="fill-current drop-shadow-[0_0_6px_rgba(34,211,238,0.55)]">
                  <use xlink:href="../assets/sprite.svg#moon"></use>   
                </svg> 
                <span>Dark</span>
              </button>

              <!-- Light button -->
              <button
                id="lightBtn"
                type="button"
                class="theme-option relative z-10 flex h-10  w-[78px] cursor-pointer items-center justify-center gap-2 rounded-full text-sm font-semibold text-zinc-400 transition-colors duration-300"
                data-theme="light">
                <svg width="28" height="28" class="fill-current drop-shadow-[0_0_6px_rgba(34,211,238,0.55)]">
                  <use xlink:href="../assets/sprite.svg#sun"></use>   
                </svg> 
                <span>Light</span>
              </button>                    
          </div>

          <!-- CTA -->
          <a 
            href="#contact"
            class="hidden rounded-xl bg-linear-to-tr from-violet-500 via-cyan-400 to-emerald-400 
            px-4 py-2 text-sm font-semibold text-zinc-950 shadow-[0_12px_40px_rgba(34,211,238,0.18)] transition 
            duration-300 hover:-translate-y-0.5 hover:shadow-[0_16px_48px_rgba(34,211,238,0.24)] focus:outline-none focus-visible:ring-2 focus-visible:ring-cyan-400 md:inline-flex">
            Contactar
          </a>

          <!-- Botón mobile -->
          <button
            id="mobileMenuBtn"
            type="button"
            class="inline-flex items-center justify-center rounded-xl bg-white/90 p-2 text-zinc-800 ring-1 ring-black/10 transition hover:bg-white focus:outline-none focus-visible:ring-2 focus-visible:ring-cyan-400 dark:bg-white/5 dark:text-zinc-200 dark:ring-white/10 dark:hover:bg-white/10 md:hidden"
            aria-label="Abrir menú"
            aria-controls="mobileMenu"
            aria-expanded="false">
            <span class="sr-only">Abrir menú</span>
            <svg
              aria-hidden="true"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              class="h-5 w-5 fill-none stroke-current"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <use xlink:href="../assets/sprite.svg#menu"></use>
            </svg>
          </button>                  
        </div>
    </div>

    <!-- Mobile menu -->
  <div
    id="mobileMenu"
    class="hidden border-t border-black/10 bg-white/90 backdrop-blur-2xl dark:border-white/10 dark:bg-zinc-950/84 md:hidden"
  >
    <nav
      class="mx-auto flex max-w-6xl flex-col gap-1 px-4 py-3 sm:px-6"
      aria-label="Navegación móvil"
    >
      <a href="#about-me" class="nav-link">Sobre mí</a>
      <a href="#skills" class="nav-link">Habilidades</a>
      <a href="#projects" class="nav-link">Proyectos</a>
      <a href="#experience" class="nav-link">Experiencia</a>
      <a href="#certifications" class="nav-link">Certificaciones</a>
      <a href="#contact" class="nav-link">Contacto</a>
    </nav>
  </div>

</header>